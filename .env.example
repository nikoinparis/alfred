# Copy to .env.local for local dev. On Vercel, add these under Project → Settings → Environment Variables.
# Never commit real values.

# Passphrase that unlocks owner mode + AI photo logging on your devices.
OWNER_PASSPHRASE=

# Vision provider for photo-to-macros: "anthropic" (default) or "gemini".
VISION_PROVIDER=anthropic

# Anthropic (https://console.anthropic.com). Model defaults to claude-sonnet-5-5;
# set claude-haiku-4-5 for roughly half the cost per photo.
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5

# Gemini (optional, free tier: Google may use free-tier prompts to improve its products).
# With VISION_PROVIDER=anthropic, Gemini is also the automatic backup when Anthropic credits run out.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
